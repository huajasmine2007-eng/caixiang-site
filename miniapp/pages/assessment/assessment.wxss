.assessment{min-height:100vh;background:#151515;color:#fff;padding:36rpx;box-sizing:border-box}.head{padding:24rpx 0 30rpx}.page-title,.page-zh,.section-title,.section-zh{display:block}.page-title{font-family:Georgia,serif;font-size:52rpx;margin-top:15rpx}.page-zh{font-size:23rpx;color:rgba(255,255,255,.45);margin-top:8rpx}.tabs{display:grid;grid-template-columns:1fr 1fr;background:rgba(255,255,255,.09);border-radius:999rpx;padding:7rpx;margin-bottom:24rpx}.tab{text-align:center;border-radius:999rpx;padding:21rpx;font-size:25rpx;color:rgba(255,255,255,.45)}.tab text{font-size:18rpx;margin-left:8rpx}.tab.active{background:#fff;color:#111}.panel{border:1rpx solid rgba(255,255,255,.12);border-radius:34rpx;padding:30rpx;background:rgba(255,255,255,.05)}.panel.light{background:#f7f7f2;color:#111}.step{font-size:19rpx;color:rgba(255,255,255,.4)}.red{color:#dd3a3a}.section-title{font-family:Georgia,serif;font-size:40rpx;margin-top:12rpx}.section-zh{font-size:21rpx;opacity:.45;margin-top:7rpx}.photo{height:560rpx;border:2rpx dashed rgba(255,255,255,.22);border-radius:28rpx;margin-top:28rpx;display:flex;align-items:center;justify-content:center;text-align:center;color:rgba(255,255,255,.5)}.photo image{width:100%;height:100%;border-radius:28rpx}.plus{display:block;font-size:70rpx}.checks{margin-top:20rpx;background:rgba(0,0,0,.2);border-radius:24rpx;padding:18rpx}.check{padding:15rpx;font-size:23rpx;color:rgba(255,255,255,.65)}.box{display:inline-grid;place-items:center;width:34rpx;height:34rpx;border:1rpx solid rgba(255,255,255,.3);border-radius:8rpx;margin-right:16rpx;color:transparent}.box.checked{background:#ef6d64;color:#fff}.action,.secondary{border:0;border-radius:999rpx;margin-top:24rpx;font-size:24rpx;padding:18rpx}.action{background:#fff;color:#111}.action::after,.secondary::after{border:0}.light .action{background:#151515;color:#fff}.light .blue{background:#174ea6}.result{background:#f7f7f2;color:#111;border-radius:28rpx;padding:30rpx;margin-top:26rpx}.result-main,.result-sub{display:block}.result-main{font-family:Georgia,serif;font-size:48rpx;margin-top:15rpx}.result-sub{font-size:23rpx;margin:15rpx 0}.metrics{margin-top:25rpx}.field{position:relative;margin-bottom:18rpx}.field>text:first-child{display:block;font-size:22rpx;margin-bottom:10rpx}.field input{height:82rpx;background:#fff;border:1rpx solid rgba(0,0,0,.1);border-radius:20rpx;padding:0 80rpx 0 22rpx}.unit{position:absolute;right:22rpx;bottom:27rpx;font-size:20rpx;opacity:.35}.question{margin-top:30rpx}.question-ko,.question-zh{display:block}.question-ko{font-family:Georgia,serif;font-size:36rpx}.question-zh{font-size:23rpx;opacity:.45;margin:10rpx 0 26rpx}.option{border:1rpx solid rgba(0,0,0,.1);background:#fff;border-radius:24rpx;padding:24rpx;margin-bottom:14rpx}.option text{display:block;font-size:23rpx}.option text+text{font-size:20rpx;opacity:.4;margin-top:7rpx}.option.selected{border-color:#174ea6;background:#eef3ff}.row{display:flex;gap:14rpx}.row button{flex:1}.row .next{flex:1.5}.secondary{background:transparent;border:1rpx solid rgba(0,0,0,.12)}
