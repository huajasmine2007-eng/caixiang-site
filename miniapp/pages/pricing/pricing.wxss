.price-head{display:grid;grid-template-columns:1fr repeat(3,100rpx);gap:8rpx;margin-top:28rpx;padding:0 18rpx;font-size:19rpx;color:rgba(0,0,0,.4);text-align:center}.price-head text:first-child{text-align:left}.group{background:#fff;border:1rpx solid rgba(0,0,0,.08);border-radius:32rpx;padding:30rpx;margin-top:18rpx}.group-ko,.group-zh,.service-ko,.service-name{display:block}.group-ko{font-family:Georgia,serif;font-size:38rpx}.group-zh{font-size:21rpx;opacity:.4;margin-top:7rpx}.service{border-top:1rpx solid rgba(0,0,0,.08);padding:26rpx 0 8rpx;margin-top:22rpx}.service-ko{font-family:Georgia,serif;font-size:27rpx}.service-name{font-size:21rpx;opacity:.45;margin-top:7rpx}.prices{display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx;margin-top:22rpx;text-align:center;font-size:24rpx;font-weight:650}.red{color:#dd3a3a}.book{margin:22rpx 0 0;background:#151515;color:#fff;border:0;border-radius:999rpx;font-size:22rpx;padding:12rpx}.book::after{border:0}.notice{font-size:20rpx;line-height:1.7;color:rgba(0,0,0,.42);padding:30rpx 8rpx}
