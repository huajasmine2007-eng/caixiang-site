.group{background:#fff;border:1rpx solid rgba(0,0,0,.08);border-radius:32rpx;padding:30rpx;margin-top:22rpx}.group-ko,.group-zh{display:block}.group-ko{font-family:Georgia,serif;font-size:38rpx}.group-zh{font-size:21rpx;opacity:.4;margin-top:7rpx}.line{display:flex;justify-content:space-between;border-top:1rpx solid rgba(0,0,0,.08);padding:24rpx 0;margin-top:20rpx;font-size:23rpx}.line text:last-child{font-weight:650}.notice{font-size:20rpx;line-height:1.7;color:rgba(0,0,0,.42);padding:30rpx 8rpx}
