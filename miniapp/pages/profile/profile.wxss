.intro{background:#174ea6;color:#fff;border-radius:40rpx;padding:38rpx}.intro .eyebrow{color:rgba(255,255,255,.6)}.intro .title{font-size:48rpx}.white{color:rgba(255,255,255,.6)}.copy{display:block;font-size:23rpx;line-height:1.8;color:rgba(255,255,255,.65);margin-top:24rpx}.slots{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:20rpx}.slot{min-height:300rpx;background:#fff;border:1rpx solid rgba(0,0,0,.08);border-radius:30rpx;padding:26rpx;display:flex;flex-direction:column}.status{color:#174ea6;font-size:38rpx}.slot-ko,.slot-zh,.note,.upload{display:block}.slot-ko{font-family:Georgia,serif;font-size:30rpx;margin-top:30rpx}.slot-zh{font-size:20rpx;opacity:.45;margin-top:6rpx}.note{font-size:19rpx;line-height:1.5;opacity:.4;margin-top:13rpx}.upload{font-size:20rpx;font-weight:600;margin-top:auto;padding-top:18rpx}.products{margin-top:55rpx}.section-title,.section-zh{display:block}.section-title{font-family:Georgia,serif;font-size:40rpx;margin-top:12rpx}.section-zh{font-size:21rpx;opacity:.4;margin:7rpx 0 24rpx}.product{background:#fff;border:1rpx solid rgba(0,0,0,.08);border-radius:25rpx;padding:25rpx;margin-bottom:13rpx}.brand{color:#dd3a3a;font-size:20rpx;font-weight:700}.category{float:right;font-size:18rpx;opacity:.35}.product-name,.product-zh{display:block}.product-name{font-family:Georgia,serif;font-size:28rpx;margin-top:18rpx}.product-zh{font-size:20rpx;opacity:.4;margin-top:8rpx}
