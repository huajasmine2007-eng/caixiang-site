<view class="page safe-bottom"><text class="eyebrow">MY AESTHETIC PROFILE</text><text class="title">나의 이전 결과</text><text class="zh">我的历史结果</text><view wx:if="{{loading}}" class="empty">正在读取…</view><view wx:elif="{{!results.length}}" class="empty">还没有保存的测试结果</view><view wx:else class="list"><view wx:for="{{results}}" wx:key="id" class="record"><view><text class="kind">{{item.kind==='color'?'COLOR':'BODY'}}</text><text class="date">{{item.date}}</text></view><text class="main">{{item.twelveType || item.colorSeason || item.bodyType+' TYPE'}}</text><text class="detail">{{item.colorType || item.frameType}} {{item.bmi?'· BMI '+item.bmi:''}}</text></view></view></view>
