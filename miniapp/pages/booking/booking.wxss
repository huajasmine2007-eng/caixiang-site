.selected{margin:30rpx 0 18rpx;background:#174ea6;color:#fff;border-radius:28rpx;padding:28rpx}.selected text{display:block}.selected text:first-child{font-size:19rpx;opacity:.55}.selected text:last-child{font-family:Georgia,serif;font-size:31rpx;margin-top:10rpx}.form{padding:30rpx}.form label{display:block;margin-bottom:28rpx}.form label:last-child{margin-bottom:0}.form label>text{display:block;font-size:22rpx;font-weight:600;margin-bottom:12rpx}.form input,.picker,.form textarea{box-sizing:border-box;width:100%;background:#f6f6f2;border:1rpx solid rgba(0,0,0,.08);border-radius:18rpx;font-size:24rpx}.form input,.picker{height:84rpx;line-height:84rpx;padding:0 22rpx}.form textarea{height:190rpx;padding:22rpx}.placeholder{color:rgba(0,0,0,.3)}.submit{margin-top:24rpx;background:#151515;color:#fff;border:0;border-radius:999rpx;font-size:25rpx;padding:18rpx}.submit::after{border:0}.privacy{display:block;text-align:center;font-size:19rpx;color:rgba(0,0,0,.35);line-height:1.6;margin:18rpx 30rpx}.success{text-align:center;margin-top:140rpx;padding:50rpx 34rpx}.success-mark{display:grid;place-items:center;margin:0 auto;width:90rpx;height:90rpx;border-radius:50%;background:#174ea6;color:#fff;font-size:45rpx}.success-ko,.success-zh{display:block}.success-ko{font-family:Georgia,serif;font-size:38rpx;margin-top:30rpx}.success-zh{font-size:24rpx;margin:10rpx 0 28rpx;color:rgba(0,0,0,.45)}
