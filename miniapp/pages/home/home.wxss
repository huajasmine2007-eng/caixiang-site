.title{white-space:pre-line}.hero{width:100%;height:390rpx;border-radius:38rpx;margin:34rpx 0;box-shadow:0 24rpx 70rpx rgba(0,0,0,.13)}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.module{min-height:300rpx;background:#fff;border:1rpx solid rgba(0,0,0,.08);border-radius:32rpx;padding:28rpx;display:flex;flex-direction:column;box-sizing:border-box}.dark{background:#151515;color:#fff}.no{font-size:20rpx;opacity:.35}.module-ko{font-family:Georgia,serif;font-size:31rpx;line-height:1.2;margin-top:58rpx}.module-zh{font-size:21rpx;opacity:.5;margin-top:8rpx}.copy{font-size:20rpx;opacity:.42;line-height:1.5;margin-top:18rpx}.arrow{font-size:21rpx;margin-top:auto;padding-top:24rpx}.history{margin-top:20rpx;border-radius:999rpx;background:#e9e8e2;padding:28rpx;text-align:center;font-size:23rpx}
