page { background: #f7f7f2; color: #151515; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { min-height: 100vh; padding: 36rpx; box-sizing: border-box; }
.eyebrow { color: #dd3a3a; font-size: 20rpx; letter-spacing: 4rpx; font-weight: 700; }
.title { font-family: Georgia, serif; font-size: 58rpx; line-height: 1.08; margin: 18rpx 0; }
.ko { display: block; font-weight: 650; }
.zh { display: block; color: rgba(21,21,21,.48); font-size: 22rpx; line-height: 1.6; margin-top: 8rpx; }
.card { background: #fff; border: 1rpx solid rgba(0,0,0,.08); border-radius: 34rpx; padding: 32rpx; box-sizing: border-box; }
.primary { background: #151515; color: #fff; border-radius: 999rpx; padding: 28rpx; text-align: center; font-size: 26rpx; }
.blue { background: #174ea6; }
.muted { color: rgba(21,21,21,.45); font-size: 24rpx; line-height: 1.7; }
.safe-bottom { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
